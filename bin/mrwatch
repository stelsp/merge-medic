#!/bin/bash
# mrwatch — console interface to merge-medic.
#   mrwatch             status: daemon, mode, budget, fixers, MR states
#   mrwatch top         live dashboard: per-fixer phase progress bars (q quits)
#   mrwatch live        merged real-time event stream for a second terminal
#   mrwatch log [-f]    tail watch.log (-f = follow)
#   mrwatch agent [iid] tail the AI resolver log (latest, or for MR <iid>)
#   mrwatch mrs         live GitLab poll: mergeability of all open MRs
#   mrwatch run         run a watcher tick right now
#   mrwatch pause       unload the launchd job (until resume)
#   mrwatch resume      load the launchd job back
set -euo pipefail

SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do SELF="$(readlink "$SELF")"; done
ROOT="$(cd "$(dirname "$SELF")/.." && pwd -P)"
LABEL="com.merge-medic.watch"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
OS="$(uname -s)"
# shellcheck source=/dev/null
[ -f "$ROOT/config.env" ] && source "$ROOT/config.env"

daemon_loaded() {
  if [ "$OS" = "Darwin" ]; then
    launchctl list 2>/dev/null | grep -q "$LABEL"
  else
    systemctl --user is-active --quiet merge-medic.timer 2>/dev/null
  fi
}

B=$(tput bold 2>/dev/null || true); N=$(tput sgr0 2>/dev/null || true)
RED=$(tput setaf 1 2>/dev/null || true); GRN=$(tput setaf 2 2>/dev/null || true)
YLW=$(tput setaf 3 2>/dev/null || true); DIM=$(tput dim 2>/dev/null || true)

latest_ai_log() { ls -t "$ROOT"/logs/ai-*.log 2>/dev/null | head -1; }

# phase → [base pct, next pct, avg duration s] for the interpolated bar
phase_base() { case "$1" in START) echo 3;; WORKTREE) echo 10;; MERGE) echo 25;; MERGE_CLEAN|AI_RESOLVE|PLAN) echo 45;; VERIFY) echo 70;; TESTS) echo 80;; REGRESSION) echo 88;; PUSH) echo 95;; DONE|FAIL|ESCALATED|PLANNED) echo 100;; DEFERRED) echo 0;; *) echo 0;; esac; }
phase_next() { case "$1" in START) echo 10;; WORKTREE) echo 25;; MERGE) echo 45;; MERGE_CLEAN|AI_RESOLVE|PLAN) echo 70;; VERIFY) echo 80;; TESTS) echo 88;; REGRESSION) echo 95;; PUSH) echo 99;; *) echo 100;; esac; }
phase_avg()  { case "$1" in START) echo 3;; WORKTREE) echo 5;; MERGE) echo 10;; MERGE_CLEAN) echo 2;; AI_RESOLVE) echo 90;; PLAN) echo 60;; VERIFY) echo 150;; TESTS) echo 60;; REGRESSION) echo 180;; PUSH) echo 5;; *) echo 1;; esac; }
is_terminal() { case "$1" in DONE|FAIL|ESCALATED|PLANNED|DEFERRED) return 0;; *) return 1;; esac; }

# interpolate percent within the current phase by elapsed time vs its average
phase_pct() { # $1=phase $2=seconds spent in this phase
  local base next avg span prog
  base="$(phase_base "$1")"; next="$(phase_next "$1")"; avg="$(phase_avg "$1")"
  [ "$base" -ge 100 ] && { echo 100; return; }
  span=$(( next - base ))
  prog=$(( ${2:-0} * span / avg ))
  [ "$prog" -gt "$span" ] && prog=$span
  echo $(( base + prog ))
}

SPINA=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
draw_bar() { # $1=pct $2=width
  local pct=$1 w=$2 filled i out=''
  filled=$(( pct * w / 100 ))
  for ((i=0; i<w; i++)); do
    if (( i < filled )); then out+='█'; else out+='░'; fi
  done
  printf '%s' "$out"
}

cmd="${1:-status}"
case "$cmd" in
  status)
    echo "${B}merge-medic${N}"

    if daemon_loaded; then
      echo "  daemon  : ${GRN}loaded${N}"
    else
      echo "  daemon  : ${RED}NOT loaded${N} — mrwatch resume"
    fi

    if [ "${DRY_RUN:-1}" = "1" ]; then
      echo "  mode    : ${YLW}DRY_RUN${N} (detect & log only)"
    else
      echo "  mode    : ${GRN}LIVE${N}"
    fi
    [ "${NOTIFY:-0}" = "1" ] && echo "  notify  : on (${NOTIFY_SOUND:-Submarine})" || echo "  notify  : off"

    today="$(date '+%Y-%m-%d')"
    spent="$(cat "$ROOT/state/budget-$today" 2>/dev/null || echo 0)"
    echo "  budget  : $spent/${DAILY_AGENT_RUNS:-?} AI runs today"

    last="$(tail -1 "$ROOT/logs/watch.log" 2>/dev/null | cut -d' ' -f1,2)"
    echo "  last run: ${last:-no log yet}"

    fpids="$(pgrep -f "$ROOT/fix-mr.sh" 2>/dev/null || true)"
    if [ -n "$fpids" ]; then
      echo "  fixers  : ${GRN}RUNNING${N} ($(echo "$fpids" | wc -l | tr -d ' ')) — mrwatch top"
    else
      flog="$(latest_ai_log)"
      [ -n "$flog" ] && echo "  fixers  : idle  ${DIM}last AI log: ${flog##*/}${N}" \
                     || echo "  fixers  : never ran yet"
    fi

    echo "  ${B}MRs (from state, no requests):${N}"
    found=0
    for f in "$ROOT"/state/mr-*; do
      [ -f "$f" ] || continue
      iid="${f##*/mr-}"
      st="$(cut -d' ' -f1 "$f")"
      mark=""
      [ -f "$ROOT/state/tried-$iid" ] && mark=" ${DIM}(this SHA pair already tried)${N}"
      case "$st" in
        conflict) echo "    !$iid  ${RED}$st${N}$mark"; found=1 ;;
        mergeable) echo "    !$iid  ${GRN}$st${N}" ;;
        *) echo "    !$iid  $st" ;;
      esac
    done
    [ "$found" = "0" ] && echo "    ${DIM}no conflicts in the last tick${N}"
    echo "  ${DIM}live check: mrwatch mrs · fixer progress: mrwatch top${N}"
    ;;

  top)
    # bash fallback dashboard; `mrtop` (Go/bubbletea) is used instead when built
    if [ -x "$ROOT/bin/mrtop" ] && [ "${2:-}" != "--once" ] && [ "${MRWATCH_PLAIN:-0}" != "1" ]; then
      exec "$ROOT/bin/mrtop" "$ROOT"
    fi
    trap 'tput cnorm 2>/dev/null; exit 0' INT TERM
    tput civis 2>/dev/null || true
    LOGP=0; tick=0
    while true; do
      now="$(date +%s)"
      tick=$((tick + 1))
      sp="${SPINA[$((tick % 10))]}"
      out=""
      out+="${B}merge-medic — live${N}   $(date '+%H:%M:%S')\n"
      today="$(date '+%Y-%m-%d')"
      day0="$(date -j -f '%Y-%m-%d %H:%M:%S' "$today 00:00:00" +%s 2>/dev/null || date -d "$today" +%s 2>/dev/null || echo 0)"
      spent="$(cat "$ROOT/state/budget-$today" 2>/dev/null || echo 0)"
      nfix="$(pgrep -f "$ROOT/fix-mr.sh" 2>/dev/null | wc -l | tr -d ' ')" || nfix=0
      daemon_loaded && d="${GRN}on${N}" || d="${RED}off${N}"

      # counters from the durable ledger (state/history.log): today + all-time
      ok=0; bad=0; esc=0; tok=0; tbad=0; tesc=0; tclean=0; tai=0
      if [ -f "$ROOT/state/history.log" ]; then
        while IFS='|' read -r ets _ outcome mode; do
          case "$outcome" in
            DONE) tok=$((tok+1)); [ "$mode" = "clean" ] && tclean=$((tclean+1)); [ "$mode" = "ai" ] && tai=$((tai+1)); [ "${ets:-0}" -ge "$day0" ] && ok=$((ok+1)) ;;
            FAIL) tbad=$((tbad+1)); [ "${ets:-0}" -ge "$day0" ] && bad=$((bad+1)) ;;
            ESCALATED) tesc=$((tesc+1)); [ "${ets:-0}" -ge "$day0" ] && esc=$((esc+1)) ;;
          esac
        done < "$ROOT/state/history.log"
      fi
      out+="  daemon $d · AI budget $spent/${DAILY_AGENT_RUNS:-?} · active: $nfix · today ${GRN}$ok✓${N} ${RED}$bad✗${N} ${YLW}$esc⚑${N} · total ${GRN}$tok✓${N} ${RED}$tbad✗${N} ${YLW}$tesc⚑${N} ($tclean clean, $tai AI)\n\n"

      shown=0; newest_log=""
      for p in "$ROOT"/state/progress-*.log; do
        [ -e "$p" ] || continue
        iid="${p##*progress-}"; iid="${iid%.log}"
        lastline="$(tail -1 "$p" 2>/dev/null)"; [ -z "$lastline" ] && continue
        ts="${lastline%%|*}"; rest="${lastline#*|}"; phase="${rest%%|*}"; detail="${rest#*|}"
        t0line="$(head -1 "$p")"; t0="${t0line%%|*}"
        active=1; is_terminal "$phase" && active=0
        # hide DONE/FAIL older than 2 hours; PLANNED stays until approved
        if [ "$active" = "0" ] && [ "$phase" != "PLANNED" ] && [ $(( now - ts )) -gt 7200 ]; then continue; fi
        inphase=$(( now - ${ts:-0} )); [ "$active" = "0" ] && inphase=0
        pct="$(phase_pct "$phase" "$inphase")"
        el=$(( ${ts:-0} - ${t0:-0} )); [ "$active" = "1" ] && el=$(( now - t0 ))
        case "$phase" in
          DONE) c="$GRN";; FAIL) c="$RED";; AI_RESOLVE|PLAN|PLANNED|ESCALATED) c="$YLW";; *) c="";;
        esac
        mark=' '; [ "$active" = "1" ] && { mark="$sp"; newest_log="$iid"; }
        printf -v line "  %s ${B}!%-4s${N} [%s] %3d%%  ${c}%-11s${N} %3dm%02ds  ${DIM}%s${N}" \
          "$mark" "$iid" "$(draw_bar "$pct" 22)" "$pct" "$phase" $((el/60)) $((el%60)) "${detail:0:56}"
        out+="$line\n"
        shown=$((shown+1))
      done
      [ "$shown" = "0" ] && out+="  ${DIM}no active or recent fixers — no conflicts${N}\n"

      # all open MRs from the last watcher tick (state cache, no requests)
      out+="\n  ${B}MRs (last tick):${N} "
      row=""
      for f in "$ROOT"/state/mr-*; do
        [ -e "$f" ] || continue
        iid="${f##*/mr-}"; st="$(cut -d' ' -f1 "$f")"
        case "$st" in
          conflict)  row+="${RED}!$iid✗${N} " ;;
          mergeable) row+="${GRN}!$iid✓${N} " ;;
          *)         row+="${DIM}!$iid?${N} " ;;
        esac
      done
      out+="${row:-${DIM}none${N}}\n"

      # optional log panel: tail of the newest active fixer's log
      if [ "$LOGP" = "1" ]; then
        lg=""
        if [ -n "$newest_log" ]; then
          lg="$(ls -t "$ROOT"/logs/ai-"$newest_log"-*.log "$ROOT"/logs/fixer-"$newest_log".log 2>/dev/null | head -1)"
        fi
        [ -z "$lg" ] && lg="$(ls -t "$ROOT"/logs/ai-*.log "$ROOT"/logs/fixer-*.log 2>/dev/null | head -1)"
        out+="\n  ${B}log${N} ${DIM}${lg##*/}${N}\n"
        if [ -n "$lg" ]; then
          while IFS= read -r ln; do out+="  ${DIM}│${N} ${ln:0:100}\n"; done < <(tail -8 "$lg" 2>/dev/null)
        fi
      fi

      out+="\n  ${DIM}q quit · l log · r tick · p pause · a approve PLANNED · MERGE→AI|CLEAN|PLAN→VERIFY→TESTS→REGRESSION→PUSH→DONE|PLANNED|ESCALATED${N}\n"
      if [ "${2:-}" = "--once" ]; then printf "%b" "$out"; exit 0; fi
      printf '\033[H\033[2J'
      printf "%b" "$out"
      read -r -t 1 -n 1 key 2>/dev/null || true
      case "${key:-}" in
        q) tput cnorm 2>/dev/null; exit 0 ;;
        l) LOGP=$((1 - LOGP)) ;;
        r) nohup bash "$ROOT/watch.sh" >/dev/null 2>&1 & ;;
        p) if daemon_loaded; then "$0" pause >/dev/null; else "$0" resume >/dev/null; fi ;;
        a)
          # approve the first PLANNED fixer: next tick re-runs it for real
          for pp in "$ROOT"/state/progress-*.log; do
            [ -e "$pp" ] || continue
            if tail -1 "$pp" | grep -q '|PLANNED|'; then
              aiid="${pp##*progress-}"; aiid="${aiid%.log}"
              rm -f "$ROOT/state/tried-$aiid" "$ROOT/state/dry-$aiid"
              touch "$ROOT/state/approve-$aiid"
              nohup bash "$ROOT/watch.sh" >/dev/null 2>&1 &
              break
            fi
          done ;;
      esac
    done
    ;;

  live)
    # merged real-time stream: watcher lines + every fixer phase event.
    # Meant to run forever in its own terminal window next to `mrwatch top`.
    touch "$ROOT/logs/watch.log" "$ROOT/logs/events.log"
    cols="$(tput cols 2>/dev/null || echo 120)"
    maxd=$(( cols - 26 )); [ "$maxd" -lt 20 ] && maxd=20
    echo "${B}merge-medic — live event stream${N} ${DIM}(Ctrl-C to quit)${N}"
    src=""
    tail -n 30 -F "$ROOT/logs/watch.log" "$ROOT/logs/events.log" 2>/dev/null \
    | while IFS= read -r line; do
        case "$line" in
          "==> "*watch.log*"<==")  src="watch";  continue ;;
          "==> "*events.log*"<==") src="events"; continue ;;
          "") continue ;;
        esac
        if [ "$src" = "events" ]; then
          ets="${line%%|*}"; rest="${line#*|}"
          eiid="${rest%%|*}"; rest="${rest#*|}"
          ephase="${rest%%|*}"; edetail="${rest#*|}"
          [ "$edetail" = "$ephase" ] && edetail=""
          case "$ephase" in
            DONE) c="$GRN";; FAIL) c="$RED";;
            AI_RESOLVE|PLAN|PLANNED|ESCALATED) c="$YLW";;
            *) c="";;
          esac
          t="$(date -r "$ets" '+%H:%M:%S' 2>/dev/null || date -d "@$ets" '+%H:%M:%S' 2>/dev/null || echo '??:??:??')"
          printf '%s %s %s%-11s%s %s\n' "${DIM}$t${N}" "${B}!$eiid${N}" "$c" "$ephase" "$N" "${DIM}${edetail:0:$maxd}${N}"
        else
          # watch.log line: "YYYY-mm-dd HH:MM:SS  msg" — keep the time, drop
          # the date, colorize by class, truncate to the terminal width
          t="${line:11:8}"; msg="${line:21}"
          if [ -z "$msg" ]; then t=""; msg="$line"; fi
          case "$line" in
            *ERROR*)                 c="$RED" ;;
            *CONFLICT*)              c="$YLW" ;;
            *"fixer ->"*)            c="$GRN" ;;
            *) c="" ;;
          esac
          printf '%s %s%s%s\n' "${DIM}${t:-        }${N}" "$c" "${msg:0:$maxd}" "$N"
        fi
      done
    ;;

  log)
    if [ "${2:-}" = "-f" ]; then tail -40 -f "$ROOT/logs/watch.log"; else tail -40 "$ROOT/logs/watch.log"; fi
    ;;

  agent)
    if [ -n "${2:-}" ] && [ "${2:-}" != "-f" ]; then
      flog="$(ls -t "$ROOT"/logs/ai-"$2"-*.log "$ROOT"/logs/fixer-"$2".log 2>/dev/null | head -1)"
    else
      flog="$(latest_ai_log)"
    fi
    [ -z "$flog" ] && { echo "no AI logs yet"; exit 0; }
    echo "${DIM}$flog${N}"
    if [ "${2:-}" = "-f" ] || [ "${3:-}" = "-f" ]; then tail -50 -f "$flog"; else tail -50 "$flog"; fi
    ;;

  mrs)
    if [ "${PROVIDER:-gitlab}" = "github" ]; then
      gh pr list --repo "$PROJECT_PATH" --state open --limit 100 \
        --json number,mergeable,headRefName,baseRefName,title 2>/dev/null \
        | jq -r '.[] | [.number, (.mergeable | ascii_downcase), .headRefName, .baseRefName, .title] | @tsv'
    else
      export GITLAB_HOST
      ENC="${PROJECT_PATH//\//%2F}"
      glab api "projects/$ENC/merge_requests?state=opened&per_page=100" 2>/dev/null \
        | jq -r '.[] | [.iid, .detailed_merge_status, .source_branch, .target_branch, .title] | @tsv'
    fi \
      | while IFS=$'\t' read -r iid st src tgt title; do
          case "$st" in
            conflict|conflicting) c="$RED" ;;
            mergeable)            c="$GRN" ;;
            *)                    c="$YLW" ;;
          esac
          [ "${PROVIDER:-gitlab}" = "github" ] && s='#' || s='!'
          printf "  %s%-4s ${c}%-22s${N} %s -> %s  ${DIM}%s${N}\n" "$s" "$iid" "$st" "$src" "$tgt" "${title:0:50}"
        done
    ;;

  run)
    echo "running a watcher tick…"
    bash "$ROOT/watch.sh"
    ;;

  pause)
    if [ "$OS" = "Darwin" ]; then
      launchctl unload "$PLIST"
    else
      systemctl --user stop merge-medic.timer
    fi
    echo "watcher paused (mrwatch resume to bring back)"
    ;;

  resume)
    if [ "$OS" = "Darwin" ]; then
      launchctl load "$PLIST"
    else
      systemctl --user start merge-medic.timer
    fi
    echo "watcher running"
    ;;

  *)
    sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
