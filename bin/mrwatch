#!/bin/bash
# mrwatch — console interface to merge-medic.
#   mrwatch             the dashboard (plain-text status when not a terminal)
#   mrwatch chat <iid>  answer an escalated MR's questions, resume the fix
#   mrwatch setup       interactive first-run helper: deps, logins, config
#   mrwatch log [-f]    tail watch.log (-f = follow)
#   mrwatch agent [iid] tail the AI resolver log (latest, or for MR <iid>)
#   mrwatch run         run a watcher tick right now
#   mrwatch pause       unload the scheduler job (until resume)
#   mrwatch resume      load the scheduler job back
set -euo pipefail

SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do SELF="$(readlink "$SELF")"; done
ROOT="$(cd "$(dirname "$SELF")/.." && pwd -P)"

INST="$(basename "$ROOT")"; INST="${INST#.}"
LABEL="com.$INST.watch"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
OS="$(uname -s)"
# shellcheck source=/dev/null
[ -f "$ROOT/config.env" ] && source "$ROOT/config.env"

daemon_loaded() {
  if [ "$OS" = "Darwin" ]; then
    launchctl list 2>/dev/null | grep -q "$LABEL"
  else
    systemctl --user is-active --quiet "$INST.timer" 2>/dev/null
  fi
}

B=$(tput bold 2>/dev/null || true); N=$(tput sgr0 2>/dev/null || true)
RED=$(tput setaf 1 2>/dev/null || true); GRN=$(tput setaf 2 2>/dev/null || true)
YLW=$(tput setaf 3 2>/dev/null || true); DIM=$(tput dim 2>/dev/null || true)

latest_ai_log() { ls -t "$ROOT"/logs/ai-*.log 2>/dev/null | head -1; }

# phase → [base pct, next pct, avg duration s] for the interpolated bar
phase_base() { case "$1" in START) echo 3;; WORKTREE) echo 10;; MERGE) echo 25;; MERGE_CLEAN|AI_RESOLVE|PLAN) echo 45;; VERIFY) echo 70;; TESTS) echo 80;; REGRESSION) echo 88;; PUSH) echo 95;; DONE|FAIL|ESCALATED|PLANNED) echo 100;; DEFERRED) echo 0;; *) echo 0;; esac; }
phase_next() { case "$1" in START) echo 10;; WORKTREE) echo 25;; MERGE) echo 45;; MERGE_CLEAN|AI_RESOLVE|PLAN) echo 70;; VERIFY) echo 80;; TESTS) echo 88;; REGRESSION) echo 95;; PUSH) echo 99;; *) echo 100;; esac; }
phase_avg()  { case "$1" in START) echo 3;; WORKTREE) echo 5;; MERGE) echo 10;; MERGE_CLEAN) echo 2;; AI_RESOLVE) echo 90;; PLAN) echo 60;; VERIFY) echo 150;; TESTS) echo 60;; REGRESSION) echo 180;; PUSH) echo 5;; *) echo 1;; esac; }
is_terminal() { case "$1" in DONE|FAIL|ESCALATED|PLANNED|DEFERRED) return 0;; *) return 1;; esac; }

# interpolate percent within the current phase by elapsed time vs its average
phase_pct() { # $1=phase $2=seconds spent in this phase
  local base next avg span prog
  base="$(phase_base "$1")"; next="$(phase_next "$1")"; avg="$(phase_avg "$1")"
  [ "$base" -ge 100 ] && { echo 100; return; }
  span=$(( next - base ))
  prog=$(( ${2:-0} * span / avg ))
  [ "$prog" -gt "$span" ] && prog=$span
  echo $(( base + prog ))
}

SPINA=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
draw_bar() { # $1=pct $2=width
  local pct=$1 w=$2 filled i out=''
  filled=$(( pct * w / 100 ))
  for ((i=0; i<w; i++)); do
    if (( i < filled )); then out+='█'; else out+='░'; fi
  done
  printf '%s' "$out"
}

# default: the dashboard in a terminal, plain status for scripts/pipes
cmd="${1:-}"
if [ -z "$cmd" ]; then
  if [ -t 1 ]; then cmd="top"; else cmd="status"; fi
fi
case "$cmd" in
  status)
    echo "${B}merge-medic${N}"

    if daemon_loaded; then
      echo "  daemon  : ${GRN}loaded${N}"
    else
      echo "  daemon  : ${RED}NOT loaded${N} — mrwatch resume"
    fi

    if [ "${DRY_RUN:-1}" = "1" ]; then
      echo "  mode    : ${YLW}DRY_RUN${N} (detect & log only)"
    else
      echo "  mode    : ${GRN}LIVE${N}"
    fi
    [ "${NOTIFY:-0}" = "1" ] && echo "  notify  : on (${NOTIFY_SOUND:-Submarine})" || echo "  notify  : off"

    today="$(date '+%Y-%m-%d')"
    spent="$(cat "$ROOT/state/budget-$today" 2>/dev/null || echo 0)"
    echo "  budget  : $spent/${DAILY_AGENT_RUNS:-?} AI runs today"

    last="$(tail -1 "$ROOT/logs/watch.log" 2>/dev/null | cut -d' ' -f1,2)"
    echo "  last run: ${last:-no log yet}"

    fpids="$(pgrep -f "$ROOT/fix-mr.sh" 2>/dev/null || true)"
    if [ -n "$fpids" ]; then
      echo "  fixers  : ${GRN}RUNNING${N} ($(echo "$fpids" | wc -l | tr -d ' ')) — mrwatch top"
    else
      flog="$(latest_ai_log)"
      [ -n "$flog" ] && echo "  fixers  : idle  ${DIM}last AI log: ${flog##*/}${N}" \
                     || echo "  fixers  : never ran yet"
    fi

    echo "  ${B}MRs (from state, no requests):${N}"
    found=0
    for f in "$ROOT"/state/mr-*; do
      [ -f "$f" ] || continue
      iid="${f##*/mr-}"
      st="$(cut -d' ' -f1 "$f")"
      mark=""
      [ -f "$ROOT/state/tried-$iid" ] && mark=" ${DIM}(this SHA pair already tried)${N}"
      case "$st" in
        conflict) echo "    !$iid  ${RED}$st${N}$mark"; found=1 ;;
        mergeable) echo "    !$iid  ${GRN}$st${N}" ;;
        *) echo "    !$iid  $st" ;;
      esac
    done
    [ "$found" = "0" ] && echo "    ${DIM}no conflicts in the last tick${N}"
    echo "  ${DIM}live check: mrwatch mrs · fixer progress: mrwatch top${N}"
    ;;

  top)
    # bash fallback dashboard; `mrtop` (Go/bubbletea) is used instead when built
    if [ -x "$ROOT/bin/mrtop" ] && [ "${2:-}" != "--once" ] && [ "${MRWATCH_PLAIN:-0}" != "1" ]; then
      exec "$ROOT/bin/mrtop" "$ROOT"
    fi
    trap 'tput cnorm 2>/dev/null; exit 0' INT TERM
    tput civis 2>/dev/null || true
    LOGP=0; tick=0
    while true; do
      now="$(date +%s)"
      tick=$((tick + 1))
      sp="${SPINA[$((tick % 10))]}"
      out=""
      out+="${B}merge-medic — live${N}   $(date '+%H:%M:%S')\n"
      today="$(date '+%Y-%m-%d')"
      day0="$(date -j -f '%Y-%m-%d %H:%M:%S' "$today 00:00:00" +%s 2>/dev/null || date -d "$today" +%s 2>/dev/null || echo 0)"
      spent="$(cat "$ROOT/state/budget-$today" 2>/dev/null || echo 0)"
      nfix="$(pgrep -f "$ROOT/fix-mr.sh" 2>/dev/null | wc -l | tr -d ' ')" || nfix=0
      daemon_loaded && d="${GRN}on${N}" || d="${RED}off${N}"

      # counters from the durable ledger (state/history.log): today + all-time
      ok=0; bad=0; esc=0; tok=0; tbad=0; tesc=0; tclean=0; tai=0
      if [ -f "$ROOT/state/history.log" ]; then
        while IFS='|' read -r ets _ outcome mode; do
          case "$outcome" in
            DONE) tok=$((tok+1)); [ "$mode" = "clean" ] && tclean=$((tclean+1)); [ "$mode" = "ai" ] && tai=$((tai+1)); [ "${ets:-0}" -ge "$day0" ] && ok=$((ok+1)) ;;
            FAIL) tbad=$((tbad+1)); [ "${ets:-0}" -ge "$day0" ] && bad=$((bad+1)) ;;
            ESCALATED) tesc=$((tesc+1)); [ "${ets:-0}" -ge "$day0" ] && esc=$((esc+1)) ;;
          esac
        done < "$ROOT/state/history.log"
      fi
      out+="  daemon $d · AI budget $spent/${DAILY_AGENT_RUNS:-?} · active: $nfix · today ${GRN}$ok✓${N} ${RED}$bad✗${N} ${YLW}$esc⚑${N} · total ${GRN}$tok✓${N} ${RED}$tbad✗${N} ${YLW}$tesc⚑${N} ($tclean clean, $tai AI)\n\n"

      shown=0; newest_log=""
      for p in "$ROOT"/state/progress-*.log; do
        [ -e "$p" ] || continue
        iid="${p##*progress-}"; iid="${iid%.log}"
        lastline="$(tail -1 "$p" 2>/dev/null)"; [ -z "$lastline" ] && continue
        ts="${lastline%%|*}"; rest="${lastline#*|}"; phase="${rest%%|*}"; detail="${rest#*|}"
        t0line="$(head -1 "$p")"; t0="${t0line%%|*}"
        active=1; is_terminal "$phase" && active=0
        # hide DONE/FAIL older than 2 hours; PLANNED stays until approved
        if [ "$active" = "0" ] && [ "$phase" != "PLANNED" ] && [ $(( now - ts )) -gt 7200 ]; then continue; fi
        inphase=$(( now - ${ts:-0} )); [ "$active" = "0" ] && inphase=0
        pct="$(phase_pct "$phase" "$inphase")"
        el=$(( ${ts:-0} - ${t0:-0} )); [ "$active" = "1" ] && el=$(( now - t0 ))
        case "$phase" in
          DONE) c="$GRN";; FAIL) c="$RED";; AI_RESOLVE|PLAN|PLANNED|ESCALATED) c="$YLW";; *) c="";;
        esac
        mark=' '; [ "$active" = "1" ] && { mark="$sp"; newest_log="$iid"; }
        printf -v line "  %s ${B}!%-4s${N} [%s] %3d%%  ${c}%-11s${N} %3dm%02ds  ${DIM}%s${N}" \
          "$mark" "$iid" "$(draw_bar "$pct" 22)" "$pct" "$phase" $((el/60)) $((el%60)) "${detail:0:56}"
        out+="$line\n"
        shown=$((shown+1))
      done
      [ "$shown" = "0" ] && out+="  ${DIM}no active or recent fixers — no conflicts${N}\n"

      # all open MRs from the last watcher tick (state cache, no requests)
      out+="\n  ${B}MRs (last tick):${N} "
      row=""
      for f in "$ROOT"/state/mr-*; do
        [ -e "$f" ] || continue
        iid="${f##*/mr-}"; st="$(cut -d' ' -f1 "$f")"
        case "$st" in
          conflict)  row+="${RED}!$iid✗${N} " ;;
          mergeable) row+="${GRN}!$iid✓${N} " ;;
          *)         row+="${DIM}!$iid?${N} " ;;
        esac
      done
      out+="${row:-${DIM}none${N}}\n"

      # optional log panel: tail of the newest active fixer's log
      if [ "$LOGP" = "1" ]; then
        lg=""
        if [ -n "$newest_log" ]; then
          lg="$(ls -t "$ROOT"/logs/ai-"$newest_log"-*.log "$ROOT"/logs/fixer-"$newest_log".log 2>/dev/null | head -1)"
        fi
        [ -z "$lg" ] && lg="$(ls -t "$ROOT"/logs/ai-*.log "$ROOT"/logs/fixer-*.log 2>/dev/null | head -1)"
        out+="\n  ${B}log${N} ${DIM}${lg##*/}${N}\n"
        if [ -n "$lg" ]; then
          while IFS= read -r ln; do out+="  ${DIM}│${N} ${ln:0:100}\n"; done < <(tail -8 "$lg" 2>/dev/null)
        fi
      fi

      out+="\n  ${DIM}q quit · l log · r tick · p pause · a approve PLANNED · MERGE→AI|CLEAN|PLAN→VERIFY→TESTS→REGRESSION→PUSH→DONE|PLANNED|ESCALATED${N}\n"
      if [ "${2:-}" = "--once" ]; then printf "%b" "$out"; exit 0; fi
      printf '\033[H\033[2J'
      printf "%b" "$out"
      read -r -t 1 -n 1 key 2>/dev/null || true
      case "${key:-}" in
        q) tput cnorm 2>/dev/null; exit 0 ;;
        l) LOGP=$((1 - LOGP)) ;;
        r) nohup bash "$ROOT/watch.sh" >/dev/null 2>&1 & ;;
        p) if daemon_loaded; then "$0" pause >/dev/null; else "$0" resume >/dev/null; fi ;;
        a)
          # approve the first PLANNED fixer: next tick re-runs it for real
          for pp in "$ROOT"/state/progress-*.log; do
            [ -e "$pp" ] || continue
            if tail -1 "$pp" | grep -q '|PLANNED|'; then
              aiid="${pp##*progress-}"; aiid="${aiid%.log}"
              rm -f "$ROOT/state/tried-$aiid" "$ROOT/state/dry-$aiid"
              touch "$ROOT/state/approve-$aiid"
              nohup bash "$ROOT/watch.sh" >/dev/null 2>&1 &
              break
            fi
          done ;;
      esac
    done
    ;;

  log)
    if [ "${2:-}" = "-f" ]; then tail -40 -f "$ROOT/logs/watch.log"; else tail -40 "$ROOT/logs/watch.log"; fi
    ;;

  agent)
    if [ -n "${2:-}" ] && [ "${2:-}" != "-f" ]; then
      flog="$(ls -t "$ROOT"/logs/ai-"$2"-*.log "$ROOT"/logs/fixer-"$2".log 2>/dev/null | head -1)"
    else
      flog="$(latest_ai_log)"
    fi
    [ -z "$flog" ] && { echo "no AI logs yet"; exit 0; }
    echo "${DIM}$flog${N}"
    if [ "${2:-}" = "-f" ] || [ "${3:-}" = "-f" ]; then tail -50 -f "$flog"; else tail -50 "$flog"; fi
    ;;

  chat)
    # Interactive escalation chat: show the bot's brief + questions, collect
    # your answers, then (optionally) approve the continuation right away.
    iid="${2:?usage: mrwatch chat <iid>}"
    BRIEF="$ROOT/state/esc-$iid.md"
    ANS="$ROOT/state/answers-$iid.md"
    mkdir -p "$ROOT/state"
    if [ ! -f "$BRIEF" ]; then
      # path-pattern escalations carry no AI brief — synthesize one from the
      # recorded escalation reason so the chat works for every escalation
      reason="$( (grep '|ESCALATED|' "$ROOT/state/progress-$iid.log" 2>/dev/null || true) | tail -1 | cut -d'|' -f3)"
      [ -z "$reason" ] && reason="escalated — reason not recorded"
      {
        printf '## Blocked
%s

' "$reason"
        printf '## Questions
1. How should this conflict be resolved? Be specific per file.
'
      } > "$BRIEF"
    fi
    echo "${B}── the bot is blocked on $iid ─────────────────────────${N}"
    cat "$BRIEF"
    echo
    if [ "${RESOLVER:-claude}" = "claude" ] && command -v claude >/dev/null 2>&1; then
      # a REAL chat: the resolver agent interviews you about its questions,
      # then writes the agreed decisions to state/answers-<iid>.md itself
      echo "${B}── opening the resolver chat${N} ${DIM}(exit the chat when you are done)${N}"
      claude "You are merge-medic's conflict resolver. You are BLOCKED on MR/PR $iid and escalated with the brief below. Start by presenting your proposed resolution from the brief in 3-5 lines and asking for a decision. Then interview the user about the numbered questions — one question at a time, demand concrete decisions, challenge vague answers (grill-me style), keep it short. You may inspect the repo clone to ground the discussion. When every question has a concrete decision: write them as a numbered markdown list to the file $ANS (create it), print the summary, and tell the user to exit the chat — the fix resumes with those answers.

Your escalation brief:
$(cat "$BRIEF")"         --model "${CLAUDE_MODEL:-sonnet}"         --add-dir "$ROOT/state" ${WATCH_REPO:+--add-dir "$WATCH_REPO"} || true
    fi
    if [ ! -s "$ANS" ]; then
      echo "${B}── no answers file yet — type them manually${N} ${DIM}(end with an empty line)${N}"
      : > "$ANS"
      while IFS= read -r line; do
        [ -z "$line" ] && break
        printf '%s
' "$line" >> "$ANS"
      done
    fi
    if [ ! -s "$ANS" ]; then
      echo "no answers recorded — nothing changes"; rm -f "$ANS"; exit 0
    fi
    # answers exist = the decision was made in the chat — resume immediately
    rm -f "$ROOT/state/tried-$iid" "$ROOT/state/dry-$iid" "$ROOT/state/deferred-$iid"
    touch "$ROOT/state/approve-$iid"
    bash "$ROOT/watch.sh" >/dev/null 2>&1 &
    echo "${GRN}answers saved — the fix is resuming${N}"
    ;;

  setup)
    # Interactive first-run helper: dependencies (offers to install them),
    # forge + resolver logins, the essential config values, the scheduler.
    cfg="$ROOT/config.env"
    [ -f "$cfg" ] || cp "$ROOT/config.example.env" "$cfg"
    echo "${B}merge-medic setup${N} — deps, logins, config. Ctrl-C anytime; re-run safely."

    PKG=""; for p in brew apt-get dnf pacman; do command -v "$p" >/dev/null 2>&1 && { PKG="$p"; break; }; done

    cfgget() { sed -n "s/^$1=[\"']\{0,1\}\([^\"']*\).*/\1/p" "$cfg" | head -1; }
    cfgset() { # key value  (values with double quotes are not supported)
      local tmp; tmp="$(mktemp)"
      if grep -q "^$1=" "$cfg"; then
        awk -v k="$1" -v v="$2" '$0 ~ "^"k"=" {print k"=\""v"\""; next} {print}' "$cfg" > "$tmp" && mv "$tmp" "$cfg"
      else
        rm -f "$tmp"; printf '%s="%s"\n' "$1" "$2" >> "$cfg"
      fi
    }
    ask() { read -rp "$1 [$2]: " REPLY; REPLY="${REPLY:-$2}"; }
    inst() { # ensure a tool exists; offer to install via the local pkg manager
      command -v "$1" >/dev/null 2>&1 && { echo "  ${GRN}✓${N} $1"; return 0; }
      local cmd=""
      case "$1:$PKG" in
        glab:brew) cmd="brew install glab";;
        glab:dnf) cmd="sudo dnf install -y glab";;
        glab:pacman) cmd="sudo pacman -S --noconfirm glab";;
        gh:brew) cmd="brew install gh";;
        gh:apt-get) cmd="sudo apt-get install -y gh";;
        gh:dnf) cmd="sudo dnf install -y gh";;
        gh:pacman) cmd="sudo pacman -S --noconfirm github-cli";;
        jq:brew) cmd="brew install jq";;
        jq:apt-get) cmd="sudo apt-get install -y jq";;
        jq:dnf) cmd="sudo dnf install -y jq";;
        jq:pacman) cmd="sudo pacman -S --noconfirm jq";;
        go:brew) cmd="brew install go";;
        go:apt-get) cmd="sudo apt-get install -y golang-go";;
        go:dnf) cmd="sudo dnf install -y golang";;
        go:pacman) cmd="sudo pacman -S --noconfirm go";;
        claude:*) cmd="curl -fsSL https://claude.ai/install.sh | bash";;
        aider:*) cmd="curl -LsSf https://aider.chat/install.sh | sh";;
      esac
      if [ -z "$cmd" ]; then
        echo "  ${RED}✗${N} $1 — no recipe for your package manager, install it manually"; return 1
      fi
      read -rp "  ${RED}✗${N} $1 missing — install via: ${B}$cmd${N} ? [Y/n] " a
      case "$a" in n|N) return 1;; esac
      eval "$cmd" || { echo "  install failed — install $1 manually and re-run"; return 1; }
      command -v "$1" >/dev/null 2>&1 && echo "  ${GRN}✓${N} $1 installed"
    }

    echo; echo "${B}1/4 forge${N}"
    d="$(cfgget PROVIDER)"; ask "Provider (gitlab/github)" "${d:-gitlab}"
    PROVIDER="$REPLY"; cfgset PROVIDER "$PROVIDER"
    FCLI=glab; [ "$PROVIDER" = "github" ] && FCLI=gh
    inst "$FCLI" || true; inst jq || true
    d="$(cfgget PROJECT_PATH)"; ask "Project (group/project or owner/repo)" "${d:-group/project}"
    PP="$REPLY"; cfgset PROJECT_PATH "$PP"
    if [ "$PROVIDER" = "gitlab" ]; then
      d="$(cfgget GITLAB_HOST)"; ask "GitLab host" "${d:-gitlab.example.com}"
      GLHOST="$REPLY"; cfgset GITLAB_HOST "$GLHOST"
      d="$(cfgget GIT_REMOTE_URL)"; ask "Git remote URL" "${d:-git@$GLHOST:$PP.git}"
      cfgset GIT_REMOTE_URL "$REPLY"
      if command -v glab >/dev/null 2>&1; then
        if GITLAB_HOST="$GLHOST" glab auth status 2>&1 | grep -q "Logged in"; then
          echo "  ${GRN}✓${N} glab logged in"
        else
          echo "  → glab is not logged in to $GLHOST — starting login:"
          glab auth login --hostname "$GLHOST" || true
        fi
      fi
    else
      cfgset GIT_REMOTE_URL "git@github.com:$PP.git"
      if command -v gh >/dev/null 2>&1; then
        if gh auth status >/dev/null 2>&1; then echo "  ${GRN}✓${N} gh logged in"
        else echo "  → gh is not logged in — starting login:"; gh auth login || true; fi
      fi
    fi

    echo; echo "${B}2/4 resolver (the AI that edits conflicts)${N}"
    d="$(cfgget RESOLVER)"; ask "Resolver (claude / aider = any model / custom)" "${d:-claude}"
    R="$REPLY"; cfgset RESOLVER "$R"
    case "$R" in
      aider)
        inst aider || true
        d="$(cfgget RESOLVER_MODEL)"; ask "Model (gpt-4o / gemini\\/gemini-2.5-pro / deepseek / ollama\\/llama3 ...)" "${d:-gpt-4o}"
        cfgset RESOLVER_MODEL "$REPLY"
        read -rp "API key env var for that provider (e.g. OPENAI_API_KEY; empty = already set): " kv
        if [ -n "$kv" ]; then
          read -rsp "Value for $kv (saved into gitignored config.env): " kval; echo
          [ -n "$kval" ] && printf 'export %s="%s"\n' "$kv" "$kval" >> "$cfg" && echo "  ${GRN}✓${N} $kv saved"
        fi
        ;;
      custom)
        d="$(cfgget RESOLVER_CMD)"; ask "RESOLVER_CMD ({prompt_file} and {mode} are substituted)" "${d:-}"
        cfgset RESOLVER_CMD "$REPLY"
        ;;
      *)
        inst claude || true
        if command -v claude >/dev/null 2>&1; then
          if claude auth status >/dev/null 2>&1; then echo "  ${GRN}✓${N} claude logged in"
          else echo "  → claude is not logged in — starting login:"; claude auth login || true; fi
        fi
        d="$(cfgget CLAUDE_MODEL)"; ask "Claude model" "${d:-opus}"
        cfgset CLAUDE_MODEL "$REPLY"
        ;;
    esac

    echo; echo "${B}3/4 project gates${N}"
    d="$(cfgget VERIFY_CMD)"; ask "Verify command (typecheck/build gate; empty = skip)" "${d:-}"
    cfgset VERIFY_CMD "$REPLY"
    d="$(cfgget AUTO_BRANCHES)"; ask "Auto-fix source branch globs (others get plan->approve)" "${d:-feat-*}"
    cfgset AUTO_BRANCHES "$REPLY"
    inst go || echo "    (no Go — the dashboard falls back to the bash version)"

    echo; echo "${B}4/4 scheduler${N}"
    read -rp "Run ./install.sh now (scheduler + mrtop build)? [Y/n] " a
    case "$a" in n|N) ;; *) bash "$ROOT/install.sh" || true;; esac
    echo
    echo "${B}done${N} — DRY_RUN=$(cfgget DRY_RUN). Watch dry ticks: ${B}mrwatch log -f${N}; go live: DRY_RUN=0 in config.env; dashboard: ${B}mrwatch top${N}"
    ;;

  run)
    echo "running a watcher tick…"
    bash "$ROOT/watch.sh"
    ;;

  pause)
    if [ "$OS" = "Darwin" ]; then
      launchctl unload "$PLIST"
    else
      systemctl --user stop "$INST.timer"
    fi
    echo "watcher paused (mrwatch resume to bring back)"
    ;;

  resume)
    if [ "$OS" = "Darwin" ]; then
      launchctl load "$PLIST"
    else
      systemctl --user start "$INST.timer"
    fi
    echo "watcher running"
    ;;

  *)
    sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
