# ── merge-medic config ────────────────────────────────────────────────────────
# Copy to config.env and fill in. config.env is gitignored.

# Provider: "gitlab" (glab CLI) or "github" (gh CLI)
PROVIDER="gitlab"

# Project (path with namespace / owner/repo) and host.
# For PROVIDER=github: PROJECT_PATH="owner/repo", GITLAB_HOST is ignored,
# auth comes from `gh auth login`.
PROJECT_PATH="group/project"
GITLAB_HOST="gitlab.example.com"
GIT_REMOTE_URL="git@gitlab.example.com:group/project.git"

# Dedicated clone the fixer works in (never touches your working checkout).
# Created lazily on the first real fix.
WATCH_REPO="$HOME/.merge-medic-repo"

# 1 = detect & log only, nothing is merged or pushed. 0 = live mode.
DRY_RUN=1

# Branches the watcher must ignore (space-separated) — e.g. the branch you are
# actively pushing to right now, to avoid non-fast-forward races.
EXCLUDE_BRANCHES=""

# Source branches fixed fully automatically (globs, space-separated).
# A conflicted MR from any OTHER source branch (e.g. a release MR dev -> main)
# is NOT auto-fixed: the bot writes a resolution plan, posts it as an MR
# comment, and waits for a human approve — hotkey `a` in the dashboard. Any
# MR comments left after the plan are read as instructions by the approved
# run. The bot never pushes to a non-auto branch without that approve.
AUTO_BRANCHES="feat-*"

# ── Don't race humans (or other agent sessions) ───────────────────────────────
# If the source branch received a push less than QUIET_MINUTES ago, the fix is
# DEFERRED — someone is probably still working on it. The watcher retries on
# every tick (the re-check is free, no AI), so the fix lands one tick after
# the branch has been quiet this long. 0 disables the check.
QUIET_MINUTES=5

# Optional: local checkouts to inspect (space-separated). If the branch is
# checked out there with uncommitted changes, the fix is deferred too.
# USER_REPOS="$HOME/code/my-project"
USER_REPOS=""

# Skip MRs marked as Draft
SKIP_DRAFTS=1

# Verification gate before push. Empty string = skip (not recommended).
VERIFY_CMD="pnpm install --frozen-lockfile --prefer-offline && pnpm typecheck && pnpm build"

# Max MRs picked up per watcher tick
MAX_MRS_PER_RUN=3

# How many fixers (fix-mr.sh) may run at once. 1 = sequential.
PARALLEL_FIXERS=1

# ── macOS notifications ───────────────────────────────────────────────────────
# 1 = notify on: new conflict, fixer started, fixed / failed.
NOTIFY=1
# Sound name from System Sounds; empty = Submarine.
NOTIFY_SOUND="Submarine"

# ── AI budget ─────────────────────────────────────────────────────────────────
# Polling GitLab costs zero tokens (bash + glab api). Tokens are spent only
# when a merge has REAL conflict markers and Claude is invoked to resolve
# them — this caps those invocations per day.
DAILY_AGENT_RUNS=6

# ── Resolver: which AI edits the conflicts ────────────────────────────────────
# claude (default) — Claude Code CLI, best-tested path, exact token/cost log
# aider           — ANY model aider supports: OpenAI, Gemini, DeepSeek,
#                   OpenRouter, local Ollama... (https://aider.chat)
# custom          — your own command (see RESOLVER_CMD)
RESOLVER="claude"

# claude: model for the resolver agent
CLAUDE_MODEL="opus"

# aider: model name, e.g. "gpt-4o", "gemini/gemini-2.5-pro", "deepseek",
# "openrouter/anthropic/claude-sonnet-4", "ollama/llama3". API keys can live
# right here (config.env is gitignored) — `export` them so aider sees them:
#   export OPENAI_API_KEY="sk-..."
#   export GEMINI_API_KEY="..."
#   export OPENROUTER_API_KEY="..."
# RESOLVER_MODEL="gpt-4o"

# custom: command run in the worktree; {prompt_file} and {mode} (plan|resolve)
# are substituted. It must edit/stage nothing in plan mode, edit files in
# resolve mode, and exit 0 on success. Token accounting is skipped.
# RESOLVER_CMD='my-agent --prompt-file {prompt_file} --mode {mode}'

# Optional file with project-specific conflict-resolution rules, appended to
# the resolver prompt (path relative to the merge-medic root, or absolute).
# Example rules: "in drizzle/ migrations keep BOTH sides", "CHANGELOG.md:
# concatenate entries, target's first".
# RESOLVE_POLICY_FILE="policy.md"

# ── Escalation & extra gates ──────────────────────────────────────────────────
# Glob patterns (space-separated) of paths the bot must NEVER resolve — a
# conflict touching them is escalated to a human immediately.
# ESCALATE_PATTERNS="src/auth/* src/payments/*"
ESCALATE_PATTERNS=""

# Focused tests on the conflicted files after an AI resolution.
# {files} is replaced with the space-separated conflicted paths.
# TEST_CMD_TEMPLATE="pnpm vitest related --run {files}"
TEST_CMD_TEMPLATE=""

# Full regression suite gate before push. REGRESSION_WHEN: ai (only after an
# AI resolution, default) | always | never.
# REGRESSION_CMD="pnpm -r run test"
REGRESSION_CMD=""
REGRESSION_WHEN="ai"

# 1 = after an AI resolution, post the resolver's per-file summary as a
# comment on the MR/PR; escalations are commented too.
POST_RESOLUTION_NOTE=0

# If glab cannot reach the OS keyring from launchd, uncomment and set a
# personal access token with api + write_repository scopes:
# export GITLAB_TOKEN="glpat-..."
