# ── merge-medic config ────────────────────────────────────────────────────────
# Copy to config.env and fill in. config.env is gitignored.

# Provider: "gitlab" (glab CLI) or "github" (gh CLI)
PROVIDER="gitlab"

# Project (path with namespace / owner/repo) and host.
# For PROVIDER=github: PROJECT_PATH="owner/repo", GITLAB_HOST is ignored,
# auth comes from `gh auth login`.
PROJECT_PATH="group/project"
GITLAB_HOST="gitlab.example.com"
GIT_REMOTE_URL="git@gitlab.example.com:group/project.git"

# Dedicated clone the fixer works in (never touches your working checkout).
# Created lazily on the first real fix.
WATCH_REPO="$HOME/.merge-medic-repo"

# 1 = detect & log only, nothing is merged or pushed. 0 = live mode.
DRY_RUN=1

# Branches the watcher must ignore (space-separated) — e.g. the branch you are
# actively pushing to right now, to avoid non-fast-forward races.
EXCLUDE_BRANCHES=""

# Skip MRs marked as Draft
SKIP_DRAFTS=1

# Verification gate before push. Empty string = skip (not recommended).
VERIFY_CMD="pnpm install --frozen-lockfile --prefer-offline && pnpm typecheck && pnpm build"

# Max MRs picked up per watcher tick
MAX_MRS_PER_RUN=3

# How many fixers (fix-mr.sh) may run at once. 1 = sequential.
PARALLEL_FIXERS=1

# ── macOS notifications ───────────────────────────────────────────────────────
# 1 = notify on: new conflict, fixer started, fixed / failed.
NOTIFY=1
# Sound name from System Sounds; empty = Submarine.
NOTIFY_SOUND="Submarine"

# ── AI budget ─────────────────────────────────────────────────────────────────
# Polling GitLab costs zero tokens (bash + glab api). Tokens are spent only
# when a merge has REAL conflict markers and Claude is invoked to resolve
# them — this caps those invocations per day.
DAILY_AGENT_RUNS=6

# Model for the resolver agent
CLAUDE_MODEL="opus"

# Optional file with project-specific conflict-resolution rules, appended to
# the resolver prompt (path relative to the merge-medic root, or absolute).
# Example rules: "in drizzle/ migrations keep BOTH sides", "CHANGELOG.md:
# concatenate entries, target's first".
# RESOLVE_POLICY_FILE="policy.md"

# If glab cannot reach the OS keyring from launchd, uncomment and set a
# personal access token with api + write_repository scopes:
# export GITLAB_TOKEN="glpat-..."
