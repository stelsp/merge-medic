# ── merge-medic config ────────────────────────────────────────────────────────
# Copy to config.env and fill in. config.env is gitignored.

# Provider: "gitlab" (glab CLI) or "github" (gh CLI)
PROVIDER="gitlab"

# Project (path with namespace / owner/repo) and host.
# For PROVIDER=github: PROJECT_PATH="owner/repo", GITLAB_HOST is ignored,
# auth comes from `gh auth login`.
PROJECT_PATH="group/project"
GITLAB_HOST="gitlab.example.com"
GIT_REMOTE_URL="git@gitlab.example.com:group/project.git"

# Dedicated clone the fixer works in (never touches your working checkout).
# Created lazily on the first real fix.
WATCH_REPO="$HOME/.merge-medic-repo"

# 1 = detect & log only, nothing is merged or pushed. 0 = live mode.
DRY_RUN=1

# Branches the watcher must ignore (space-separated) — e.g. the branch you are
# actively pushing to right now, to avoid non-fast-forward races.
EXCLUDE_BRANCHES=""

# Allowlist of source-branch prefixes/globs (space-separated). When set, only
# MRs from matching branches are handled AT ALL — everything else is ignored
# (not even planned). Empty = all branches. Example: "feat-* fix-* docs/*"
INCLUDE_BRANCHES=""

# Source branches fixed fully automatically (globs, space-separated).
# A conflicted MR from any OTHER source branch (e.g. a release MR dev -> main)
# is NOT auto-fixed: the bot writes a resolution plan, posts it as an MR
# comment, and waits for a human approve — hotkey `a` in the dashboard. Any
# MR comments left after the plan are read as instructions by the approved
# run. The bot never pushes to a non-auto branch without that approve.
AUTO_BRANCHES="feat-*"

# ── Don't race humans (or other agent sessions) ───────────────────────────────
# If the source branch received a push less than QUIET_MINUTES ago, the fix is
# DEFERRED — someone is probably still working on it. The watcher retries on
# every tick (the re-check is free, no AI), so the fix lands one tick after
# the branch has been quiet this long. 0 disables the check.
QUIET_MINUTES=5

# Optional: local checkouts to inspect (space-separated). The fix is deferred
# when the branch is being worked on there — uncommitted changes, or a commit
# newer than QUIET_MINUTES that has not been pushed yet.
#
# Coding agents get one worktree per branch, so a checkout listed here covers
# its worktrees too: both the ones git has registered and the conventional
# <repo>/.worktrees/<branch> layout. Point this at the main checkout, not at
# each worktree.
# USER_REPOS="$HOME/code/my-project"
USER_REPOS=""

# Skip MRs marked as Draft
SKIP_DRAFTS=1

# Verification gate before push. Empty string = skip (not recommended).
VERIFY_CMD="pnpm install --frozen-lockfile --prefer-offline && pnpm typecheck && pnpm build"

# Max MRs picked up per watcher tick
MAX_MRS_PER_RUN=3

# How many fixers (fix-mr.sh) may run at once. 1 = sequential.
PARALLEL_FIXERS=1

# Deadlines, in whole seconds (0 = none; anything else that is not a
# number means the default). A step still running past its deadline is
# stopped with everything it started (TERM, then KILL 5s later) instead of
# hanging: a stuck fixer would hold its slot, and a watcher tick waiting for
# that slot, for good. A timed-out fetch, push, AI call, gate or git step
# fails the run; a timed-out MR lookup or comment is logged and the run goes
# on. NET_TIMEOUT also bounds each of the watcher's own forge calls, fetches
# and clones: a listing that times out counts as one that failed. The first
# clone of a large repository may need more than the default.
RESOLVER_TIMEOUT=900     # one AI call (plan or resolve)
GATE_TIMEOUT=1800        # each of VERIFY_CMD / TEST_CMD_TEMPLATE / REGRESSION_CMD
NET_TIMEOUT=300          # each git fetch/push and forge API call
GIT_TIMEOUT=300          # each local git step: checkout (LFS downloads
                         # included), merge, commit (hooks and signing
                         # included when they are on)

# The bot's own git steps run no git hooks and sign nothing, whatever the
# clone's or your global git config says: a hook or a signing agent waiting
# for a passphrase or a touch would wait unattended. Turn either on here.
# With RUN_GIT_HOOKS=1 a pre-push hook runs inside the push, which then gets
# GIT_TIMEOUT on top of NET_TIMEOUT. The gates (VERIFY_CMD etc.) are not
# affected: they see git as it is configured.
RUN_GIT_HOOKS=0
SIGN_BOT_COMMITS=0

# ── macOS notifications ───────────────────────────────────────────────────────
# 1 = notify on: new conflict, fixer started, fixed / failed.
NOTIFY=1
# Sound name from System Sounds; empty = Submarine.
NOTIFY_SOUND="Submarine"

# ── AI budget ─────────────────────────────────────────────────────────────────
# Polling GitLab costs zero tokens (bash + glab api). Tokens are spent only
# when a merge has REAL conflict markers and Claude is invoked to resolve
# them — this caps those invocations per day.
# Daily cap on AI invocations; 0 = unlimited (runs are still counted)
DAILY_AGENT_RUNS=6

# ── Resolver: which AI edits the conflicts ────────────────────────────────────
# claude (default) — Claude Code CLI, best-tested path, exact token/cost log
# aider           — ANY model aider supports: OpenAI, Gemini, DeepSeek,
#                   OpenRouter, local Ollama... (https://aider.chat)
# custom          — your own command (see RESOLVER_CMD)
RESOLVER="claude"

# claude: model for the resolver agent
CLAUDE_MODEL="opus"
# claude: effort for the resolver (low, medium, high, xhigh, max); empty =
# the CLI's default. Your own Claude Code settings do not apply to the
# resolver: it runs with --restricted (see below), so set it here.
CLAUDE_EFFORT=""
# claude: a settings file (or JSON) handed to the resolver with --settings,
# for auth or provider setup that does not live in the keychain login
# (apiKeyHelper, an env block). Keep it to that: permission rules in it
# would widen the fence below.
CLAUDE_SETTINGS=""
#
# The claude resolver runs fenced in: none of your Claude Code settings,
# hooks, plugins or MCP servers load; it has the file tools, confined to its
# worktree (no write tools when planning), and a shell that runs only git
# status / log / show / diff (alone or against --cached, HEAD, MERGE_HEAD),
# and when resolving git add / rm / checkout --ours / --theirs. Anything else
# is denied without asking. The CLI also refuses its writes to git and tool
# configuration files (.gitmodules, .claude/, editor settings): a conflict in
# one fails the run instead of being resolved.
#
# Inside every resolver git's transports are switched off
# (GIT_ALLOW_PROTOCOL), so no fetch or push reaches a remote. aider and a
# custom command can run anything, that switch included: only the claude
# resolver is fenced in.
#
# If an AI call changes git's own state anyway (config, local refs, and
# hooks when RUN_GIT_HOOKS=1) or pushes by remote name, the run fails and
# state/quarantined stops all fixing until you have looked at WATCH_REPO and
# removed that file. With RUN_GIT_HOOKS=1 and PARALLEL_FIXERS above 1, a gate
# that installs hooks into the clone (husky, lefthook) while another fixer's
# AI call runs trips it as well.

# model for the dashboard's hotspot analyses (screen 2, key `i`) — its own
# knob so a cheap model can explain hotspots while a strong one resolves.
# Defaults to CLAUDE_MODEL. Cycled with ←→ on the hotspots screen.
#HOTSPOT_MODEL="haiku"

# aider: model name, e.g. "gpt-4o", "gemini/gemini-2.5-pro", "deepseek",
# "openrouter/anthropic/claude-sonnet-4", "ollama/llama3". API keys can live
# right here (config.env is gitignored) — `export` them so aider sees them:
#   export OPENAI_API_KEY="sk-..."
#   export GEMINI_API_KEY="..."
#   export OPENROUTER_API_KEY="..."
# RESOLVER_MODEL="gpt-4o"

# custom: command run in the worktree; {prompt_file} and {mode} (plan|resolve)
# are substituted. It must edit/stage nothing in plan mode, edit files in
# resolve mode, and exit 0 on success. Token accounting is skipped.
# RESOLVER_CMD='my-agent --prompt-file {prompt_file} --mode {mode}'

# Optional file with project-specific conflict-resolution rules, appended to
# the resolver prompt (path relative to the merge-medic root, or absolute).
# Example rules: "in drizzle/ migrations keep BOTH sides", "CHANGELOG.md:
# concatenate entries, target's first".
# RESOLVE_POLICY_FILE="policy.md"

# ── Escalation & extra gates ──────────────────────────────────────────────────
# Glob patterns (space-separated) of paths the bot must NEVER resolve — a
# conflict touching them is escalated to a human immediately. A pattern
# covers its whole subtree: src/auth/* also protects src/auth/jwt/sign.ts.
# ESCALATE_PATTERNS="src/auth/* src/payments/*"
ESCALATE_PATTERNS=""

# Focused tests on the conflicted files after an AI resolution.
# {files} is replaced with the space-separated conflicted paths.
# TEST_CMD_TEMPLATE="pnpm vitest related --run {files}"
TEST_CMD_TEMPLATE=""

# Full regression suite gate before push. REGRESSION_WHEN: ai (only after an
# AI resolution, default) | always | never.
# REGRESSION_CMD="pnpm -r run test"
REGRESSION_CMD=""
REGRESSION_WHEN="ai"

# 1 = after an AI resolution, post the resolver's per-file summary as a
# comment on the MR/PR; escalations are commented too.
POST_RESOLUTION_NOTE=0

# If glab cannot reach the OS keyring from launchd, uncomment and set a
# personal access token with api + write_repository scopes:
# export GITLAB_TOKEN="glpat-..."

# Comments on a planned MR become INSTRUCTIONS for the approved run (an agent
# with push rights) — so only trusted usernames are read. Space-separated
# forge usernames; empty = only the MR author is trusted.
TRUSTED_AUTHORS=""

# How the fix is delivered:
#   mr (default) — the bot NEVER touches your branch: the resolution is
#                  pushed to merge-medic/fix-<iid>-<ts> and opened as an
#                  MR/PR into the source branch; you review the diff and
#                  press merge. While one is open for an MR, new pushes
#                  wait for it (re-checked hourly) instead of opening
#                  another, and resolution MRs are never themselves picked
#                  up as work. An approved run, or a lookup the forge does
#                  not answer, can still open a second one
#   direct       — the merge commit is pushed straight into the source branch
#                  (one step fewer, and the bot needs push rights to it)
#
# mr is the default because a branch someone — or some coding agent — is
# actively working in should not move under them. Switch to direct for
# branches nobody has checked out, or once you trust the resolutions.
PUSH_MODE="mr"

# ── deterministic rules (no model, no tokens) ─────────────────────────────────
# Some conflicts carry no decision at all: a stamp line that every branch
# rewrites, and that conflicts on every merge. RULES_KEEP_OURS is an extended
# regex; a conflict hunk whose two sides differ ONLY in lines matching it is
# resolved in favour of your branch, before the resolver is ever called.
#
# A hunk where anything else differs (a line changed, moved or repeated) is
# left untouched for the model, so this cannot quietly drop a real change.
# Conflicts git writes no markers for (modify/delete, binary files) are never
# decided here either. Empty = the layer is off.
#
#   RULES_KEEP_OURS='^> verified: '            one stamp
#   RULES_KEEP_OURS='^> verified: |^Generated: '   several, | separated
RULES_KEEP_OURS=""

# Conflict radar: warn when two open MRs conflict with each other (free
# in-memory merge-tree checks each poll). 0 disables.
RADAR=1
